# AI Travel Planner configuration. Copy to .env (git-ignored) and fill in:
#   cp .env.example .env
# The Python services read this file from the repo root; Next.js reads it too
# but only exposes variables prefixed with NEXT_PUBLIC_ to the browser.

# --- Gemini (choose ONE option) ----------------------------------------------
# Option A: Gemini API key from Google AI Studio — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Option B: Vertex AI (uses Application Default Credentials: gcloud auth application-default login)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model used by every agent (ADK default in google-adk 2.15).
GEMINI_MODEL=gemini-3.5-flash

# --- Network layout (defaults shown) ------------------------------------------
# AGENT_HOST=127.0.0.1          # interface services bind to
# AGENT_PUBLIC_HOST=localhost   # host advertised in Agent Cards
# COORDINATOR_PORT=8000
# DESTINATION_AGENT_PORT=8001
# BUDGET_AGENT_PORT=8002
# ITINERARY_AGENT_PORT=8003
# Override if specialists run elsewhere (e.g. another machine or container):
# DESTINATION_AGENT_URL=http://localhost:8001
# BUDGET_AGENT_URL=http://localhost:8002
# ITINERARY_AGENT_URL=http://localhost:8003

# --- Coordinator behaviour ----------------------------------------------------
# A2A_TIMEOUT_SECONDS=180       # per remote task attempt
# A2A_MAX_RETRIES=1             # retries after a failed/timed-out/invalid task
# DISCOVERY_TIMEOUT_SECONDS=5
# MAX_CONCURRENT_EXECUTIONS=4
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# COORDINATOR_DB_PATH=/absolute/path/coordinator.db   # default: backend/.data/coordinator.db
# LOG_LEVEL=INFO

# --- Frontend -----------------------------------------------------------------
# Coordinator URL used by the browser (inlined at build time).
NEXT_PUBLIC_COORDINATOR_URL=http://localhost:8000
