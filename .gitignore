# See https://git-scm.com/docs/gitignore for pattern syntax.

# --- Secrets / environment -----------------------------------------------------
# Real configuration lives in .env (never commit it). The template is tracked.
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
application_default_credentials.json

# --- Node / Next.js frontend ---------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.next/
/out/
/build
/coverage
.vercel
*.tsbuildinfo
next-env.d.ts

# --- Python backend ------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
# Coordinator SQLite event store (COORDINATOR_DB_PATH)
backend/.data/
*.db
*.db-shm
*.db-wal

# --- Logs ------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Editors / OS ------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
